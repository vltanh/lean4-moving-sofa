lemma ga_C2 (hP : P.IsSolution) :
    curveArea (contactC P.path) P.φ P.θ = 1 / 2 *
      ((ga_K_C2 P.b₁ P.κ₂.1 P.κ₂.2).F P.θ (cos P.θ) (sin P.θ) -
