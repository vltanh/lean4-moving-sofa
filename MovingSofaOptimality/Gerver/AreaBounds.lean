    (L := (-1.420645046 : ℝ)) (U := (-1.420644644 : ℝ)) (by norm_num)
  have h5 := ga_iv_mul_pn h2 h4
    (L := (-1.420645188065 : ℝ)) (U := (-1.420644501935 : ℝ)) (by norm_num)
  have h6 := ga_iv_sub h1 h5
