          (cos (π / 2 - P.θ)) (sin (π / 2 - P.θ))) := by
  have hO := gs_ord hP
  refine ga_phase_C hP hO.lt_φ' ga_continuous_ρC₃ (fun t ht => gs_piece₃ ht.1 ht.2) _ fun t => ?_
  rw [ga_cross_C]
  simp only [gs_phase, gs_ph4, gs_Phase.ρC, ga_TP.dF, ga_K_C4]
  ring

