/-- Coefficients of an antiderivative of `𝐃 × 𝐃'` on phase `[φ, θ]`. -/
noncomputable def ga_K_D2 (b1 k1 k2 : ℝ) : ga_TP where
  p1 := (1 + b1) * (1 + b1)
  p2 := -((1 + b1) / 2)
  p3 := 1 / 12
  p4 := 0
  p5 := 0
  q0 := -((((2 * (b1 * k1)) + (2 * k1)) - k2) / 2)
  q1 := k1 / 2
  q2 := 0
  r0 := -((((2 * (b1 * k2)) + (2 * k2)) + k1) / 2)
  r1 := k2 / 2
  r2 := 0

