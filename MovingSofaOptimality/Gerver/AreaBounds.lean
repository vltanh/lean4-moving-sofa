lemma ga_D2 (hP : P.IsSolution) :
    curveArea (contactD P.path) P.φ P.θ = 1 / 2 *
      ((ga_K_D2 P.b₁ P.κ₂.1 P.κ₂.2).F P.θ (cos P.θ) (sin P.θ) -
        (ga_K_D2 P.b₁ P.κ₂.1 P.κ₂.2).F P.φ (cos P.φ) (sin P.φ)) := by
  have hO := gs_ord hP
  refine ga_phase_D hP hO.φ_lt_θ ga_continuous_ρC₁ (fun t ht => gs_piece₁ ht.1 ht.2) _ fun t => ?_
  rw [ga_cross_D]
  simp only [gs_phase, gs_ph2, gs_Phase.ρC, ga_TP.dF, ga_K_D2]
  ring

lemma ga_D2_mem (hP : P.IsSolution) (hB : P.Bounds) :
    curveArea (contactD P.path) P.φ P.θ ∈ Icc (-0.036688331528 : ℝ) (-0.036687267926 : ℝ) := by
  rw [ga_D2 hP]
  exact ga_num_D2 hB.b₁_mem hB.κ₂₁_mem hB.κ₂₂_mem hB.φ_mem (ga_cos_φ_mem hB) (ga_sin_φ_mem hB)
    hB.θ_mem (ga_cos_θ_mem hB) (ga_sin_θ_mem hB)

/-! ### The six curve areas -/

/-- The curve area `𝒥(𝐀|[0, π/2]) = 0.72016…`. -/
theorem ga_curveArea_A_mem (hP : P.IsSolution) (hB : P.Bounds) :
    curveArea (contactA P.path) 0 (π / 2) ∈ Icc (0.7201 : ℝ) (0.7202 : ℝ) := by
  have hO := gs_ord hP
  rw [ga_split_five hO.φ_pos.le hO.φ_lt_θ.le hO.θ_lt.le hO.lt_φ'.le (by linarith [hO.φ_pos])
    (ga_isCBV_A hP), ga_A1 hP]
  have h0 := ga_A2_mem hP hB
  have h1 := ga_A3_mem hP hB
  have h2 := ga_A4_mem hP hB
  have h3 := ga_A5_mem hP hB
  constructor <;> linarith [h0.1, h0.2, h1.1, h1.2, h2.1, h2.2, h3.1, h3.2]

/-- The curve area `𝒥(𝐂|[0, π/2]) = 1.33392…`. -/
theorem ga_curveArea_C_mem (hP : P.IsSolution) (hB : P.Bounds) :
    curveArea (contactC P.path) 0 (π / 2) ∈ Icc (1.3339 : ℝ) (1.334 : ℝ) := by
  have hO := gs_ord hP
  rw [ga_split_five hO.φ_pos.le hO.φ_lt_θ.le hO.θ_lt.le hO.lt_φ'.le (by linarith [hO.φ_pos])
    (ga_isCBV_C hP), ga_C5 hP]
  have h0 := ga_C1_mem hP hB
  have h1 := ga_C2_mem hP hB
  have h2 := ga_C3_mem hP hB
  have h3 := ga_C4_mem hP hB
  constructor <;> linarith [h0.1, h0.2, h1.1, h1.2, h2.1, h2.2, h3.1, h3.2]

