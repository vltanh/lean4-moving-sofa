lemma ga_C4 (hP : P.IsSolution) :
    curveArea (contactC P.path) (π / 2 - P.θ) (π / 2 - P.φ) = 1 / 2 *
      ((ga_K_C4 P.d₁ P.d₂ P.κ₄.1 P.κ₄.2).F (π / 2 - P.φ) (cos (π / 2 - P.φ)) (sin (π / 2 - P.φ)) -
