lemma ga_X4 (hP : P.IsSolution) :
    curveArea P.path (π / 2 - P.θ) (π / 2 - P.φ) = 1 / 2 *
      ((ga_K_X4 P.d₁ P.d₂ P.κ₄.1 P.κ₄.2).F (π / 2 - P.φ) (cos (π / 2 - P.φ)) (sin (π / 2 - P.φ)) -
        (ga_K_X4 P.d₁ P.d₂ P.κ₄.1 P.κ₄.2).F (π / 2 - P.θ)
          (cos (π / 2 - P.θ)) (sin (π / 2 - P.θ))) := by
  have hO := gs_ord hP
  refine ga_phase_X hP hO.lt_φ' (fun t ht => gs_piece₃ ht.1 ht.2) _ fun t => ?_
  rw [ga_cross_X]
  simp only [gs_phase, gs_ph4, gs_Phase.α, gs_Phase.β, ga_TP.dF, ga_K_X4]
  ring

lemma ga_X4_mem (hP : P.IsSolution) (hB : P.Bounds) :
    curveArea P.path (π / 2 - P.θ) (π / 2 - P.φ) ∈
      Icc (0.442145595695 : ℝ) (0.442153006774 : ℝ) := by
  rw [ga_X4 hP]
  exact ga_num_X4 (ga_d₁_mem hP hB) (ga_d₂_mem hP hB) hB.κ₄₁_mem hB.κ₄₂_mem (ga_pth_mem hB)
    (by rw [cos_pi_div_two_sub]; exact ga_sin_θ_mem hB)
    (by rw [sin_pi_div_two_sub]; exact ga_cos_θ_mem hB) (ga_pphi_mem hB)
    (by rw [cos_pi_div_two_sub]; exact ga_sin_φ_mem hB)
    (by rw [sin_pi_div_two_sub]; exact ga_cos_φ_mem hB)

