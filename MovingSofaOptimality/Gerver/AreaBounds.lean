noncomputable def ga_K_C4 (d1 d2 k1 k2 : ℝ) : ga_TP where
  p1 := ((1 + d2) * (1 + (2 * d2))) / 2
  p2 := (d1 * (3 + (4 * d2))) / 4
  p3 := (((8 * (d1 * d1)) - 3) - (4 * d2)) / 24
  p4 := -(d1 / 8)
  p5 := 1 / 80
  q0 := ((d1 * k2) + (d2 * k1)) + k1
  q1 := ((2 * (d1 * k1)) - k2) / 2
  q2 := -(k1 / 4)
  r0 := ((d2 * k2) + k2) - (d1 * k1)
  r1 := ((2 * (d1 * k2)) + k1) / 2
  r2 := -(k2 / 4)

